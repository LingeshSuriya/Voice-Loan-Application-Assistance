# Voice-Only Loan Application Assistant Environment Configuration

# Sarvam AI API Key (for live Indian Language STT & TTS)
# Sign up at https://dashboard.sarvam.ai/
SARVAM_API_KEY=

# Google Gemini API Key (for LLM Structured Field Extraction)
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=

# Application Settings
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./voice_loan.db
DEFAULT_LANGUAGE=hi-IN
FALLBACK_TO_MOCK=true
